          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/:productId/stock-logs?type=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", ":productId", "stock-logs"],
              "query": [
                {
                  "key": "type",
                  "value": "",
                  "description": "IN hoặc OUT",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ],
              "variable": [
                {
                  "key": "productId",
                  "value": "1"
                }
              ]
            },
            "description": "Lấy lịch sử nhập/xuất kho của một sản phẩm"
          }
